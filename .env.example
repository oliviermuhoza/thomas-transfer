# TOM Safaris — local configuration.
#
# Copy this file to `.env` (which is gitignored) and fill in the values.
# `backend/app.py` reads `.env` at import time, and real environment variables
# always win over the file. Set TT_NO_ENV_FILE=1 to ignore it (the test suite
# does this). On Vercel the dashboard variables are used instead; this file is
# never shipped as configuration.

# --- Admin bootstrap -------------------------------------------------------
# Used only when the database has no admin yet. Changing them later does not
# change an existing account: the row in the database is the source of truth.
TT_ADMIN_EMAIL=admin@thomastransfer.com
TT_ADMIN_PASSWORD=

# --- Sessions --------------------------------------------------------------
# Signs session cookies. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Leave empty in development to use the generated `backend/data/secret_key`.
SECRET_KEY=

# --- Local server (only used by `python -m backend.app`) -------------------
# TT_HOST=127.0.0.1
# TT_PORT=5000
# TT_DEBUG=1

# --- Database --------------------------------------------------------------
# Defaults to backend/data/thomas.db, then a writable temp folder.
# TT_DATABASE=

# --- Remote database (Turso / libSQL) --------------------------------------
# Leave empty for the local SQLite file. Set both to persist bookings in
# production; the Vercel Turso integration injects these two names for you.
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=
# Force a driver instead of detecting it from the path: sqlite | libsql
# TT_DB_DRIVER=
# Allow a production run on /tmp. Disposable demos only; data is lost on restart.
# TT_ALLOW_EPHEMERAL_DB=

# --- Production only -------------------------------------------------------
# Never enable these on http://localhost: secure cookies are not sent over
# plain HTTP, so logins would silently fail.
# TT_ENV=production
# TT_COOKIE_SECURE=1

# --- Behind a reverse proxy (nginx, Cloudflare) ---------------------------
# TT_TRUST_PROXY_HEADERS=1
# TT_TRUSTED_PROXY_HOPS=1

# --- Rate limiting ---------------------------------------------------------
# TT_RATE_LIMIT_BACKEND=memory
# TT_REDIS_URL=

# --- Password reset email (SMTP) -------------------------------------------
# Without TT_SMTP_HOST nothing is sent: the reset link is logged outside
# production and an error is logged in production.
# TT_SMTP_HOST=smtp.example.com
# TT_SMTP_PORT=587
# TT_SMTP_USER=
# TT_SMTP_PASSWORD=
# TT_SMTP_FROM=TOM Safaris <no-reply@example.com>
# TT_SMTP_SECURITY=starttls
